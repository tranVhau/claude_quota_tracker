<Window x:Class="ClaudeQuotaTracker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="360"
        SizeToContent="Height"
        Background="{StaticResource ThemeBg}"
        Foreground="{StaticResource ThemeText}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TabControl>

            <TabItem Header="General">
                <StackPanel Margin="0,12,0,0">
                    <TextBlock Text="Refresh interval" Foreground="{StaticResource ThemeTextSecondary}"
                               FontSize="11.5" Margin="0,0,0,4"/>
                    <ComboBox x:Name="IntervalCombo" Margin="0,0,0,12">
                        <ComboBoxItem Content="1 min" Tag="60"/>
                        <ComboBoxItem Content="5 min" Tag="300"/>
                        <ComboBoxItem Content="30 min" Tag="1800"/>
                        <ComboBoxItem Content="2 hr" Tag="7200"/>
                    </ComboBox>

                    <TextBlock Text="Icon shows" Foreground="{StaticResource ThemeTextSecondary}"
                               FontSize="11.5" Margin="0,0,0,4"/>
                    <ComboBox x:Name="MetricCombo" Margin="0,0,0,14">
                        <ComboBoxItem Content="Higher of the two"/>
                        <ComboBoxItem Content="Session (5h)"/>
                        <ComboBoxItem Content="Week (7d)"/>
                    </ComboBox>

                    <CheckBox x:Name="AutoStartCheck" Content="Start with Windows"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Triggers">
                <StackPanel x:Name="ShiftsPanel" Margin="0,12,0,0"/>
            </TabItem>

        </TabControl>

        <Button Content="Save" Click="Save_Click" Margin="0,18,0,0" Height="30"
                Style="{StaticResource AccentButton}"/>
    </StackPanel>
</Window>
